{
  "name": "@wealth_api/mcp-server",
  "mcpName": "eu.wealthapi/mcp-server",
  "version": "0.1.0",
  "description": "General-purpose MCP server for the wealthAPI platform. Lets an AI assistant answer everyday portfolio questions on the user's behalf.",
  "license": "MIT",
  "type": "module",
  "main": "build/library.js",
  "types": "build/library.d.ts",
  "exports": {
    ".": {
      "types": "./build/library.d.ts",
      "default": "./build/library.js"
    }
  },
  "bin": {
    "wealthapi-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealthAPI-eu/wealthapi-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wealthapi",
    "finance",
    "portfolio",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
