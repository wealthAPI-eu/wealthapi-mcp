{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "eu.wealthapi/mcp-server",
  "description": "Read-only MCP server for wealthAPI: portfolio, cash-flow, and dividend insights for AI assistants.",
  "repository": {
    "url": "https://github.com/wealthAPI-eu/wealthapi-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@wealth_api/mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BEARER_TOKEN",
          "description": "Personal wealthAPI API token (wapi_key_…)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LOG_LEVEL",
          "description": "Logging verbosity (debug, info, warn, error)",
          "default": "info"
        }
      ]
    }
  ]
}
